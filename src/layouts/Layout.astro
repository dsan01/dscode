---
import Navbar from '@generics/Navbar.astro'
import SEO from '@generics/SEO.astro'
import '../styles/global.css'
import Footer from '@generics/Footer.astro'
import BackToTop from '@generics/BackToTop.astro'
const currentLang = Astro.currentLocale
import { type LayoutMetaProps as Props } from '@data/props'
import { UMAMI_URL, UMAMI_CODE } from 'astro:env/client'

const { seo } = Astro.props
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta
      name='generator'
      content={Astro.generator}
    />

    <SEO {seo} />

    <link
      rel='icon'
      type='image/png'
      href='/favicon-96x96.png'
      sizes='96x96'
    />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/favicon.svg'
    />
    <link
      rel='shortcut icon'
      href='/favicon.ico'
    />
    <link
      rel='apple-touch-icon'
      sizes='180x180'
      href='/apple-touch-icon.png'
    />
    <meta
      name='apple-mobile-web-app-title'
      content='DSCode'
    />
    <link
      rel='manifest'
      href='/site.webmanifest'
    />
    <script defer src={UMAMI_URL} data-website-id={UMAMI_CODE} data-performance="true"></script>
  </head>
  <body>
    <Navbar />
        <!-- Mira más allá de tu corazón,
allí comienza la misión.
Cuando el símbolo logres hallar,
tres veces lo debes tocar. -->
    <slot />
    <Footer />
    <BackToTop />
  </body>
</html>
